# Variables públicas de Supabase. Son suficientes para la aplicación y las API de lectura.
VITE_SUPABASE_URL=https://vmzkhelxehgedorsvchl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Opcionales para funciones server-side. Si faltan, Primy usa los valores públicos anteriores.
SUPABASE_URL=https://vmzkhelxehgedorsvchl.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Las sincronizaciones numéricas y deportivas siguen en Supabase. La sincronización hípica server-side puede usar service_role y CRON_SECRET exclusivamente en Vercel o en otro backend protegido.
RESULT_CACHE_TTL_MINUTES=1080

# Solo servidor: necesario si /api/sync-horse-rounds escribe directamente en Supabase.
# No debe exponerse con prefijo VITE_ ni incluirse en el cliente.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET

# Opcionales para pruebas, proxy controlado o cambios de URL oficiales.
SELAE_LOTOTURF_PROGRAM_URL=
SELAE_QUINTUPLE_PLUS_PROGRAM_URL=
SELAE_HORSE_WITHDRAWALS_URL=
SELAE_LOTOTURF_RESULT_URL=
SELAE_QUINTUPLE_PLUS_RESULT_URL=
